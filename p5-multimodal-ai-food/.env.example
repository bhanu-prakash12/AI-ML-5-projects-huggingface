# macOS only (ignored elsewhere): let unsupported ops fall back to CPU
PYTORCH_ENABLE_MPS_FALLBACK=1
TOKENIZERS_PARALLELISM=false
# set to 1 after models are downloaded (run.py sets it itself for serve/demo/smoke)
HF_HUB_OFFLINE=0
# Optional USDA FoodData Central API key. Empty = use the official bulk CSV downloads (default)
FDC_API_KEY=
P5_PROFILE=small
# Set to 1 to silence colors in the console narration
# NO_COLOR=1
